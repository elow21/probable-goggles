<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CYBERSEC_FEED // THREAT INTEL</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --green:      #00ff41;
      --green-dim:  #00aa2b;
      --green-dark: #003d12;
      --cyan:       #00e5ff;
      --bg:         #080808;
      --bg-card:    #0c130c;
      --border:     #1a3a1a;
      --text-dim:   #4a8a4a;
      --text-muted: #2a4a2a;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--green);
      font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
      font-size: 14px;
      line-height: 1.6;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Scanline overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background: repeating-linear-gradient(
        to bottom,
        transparent 0px,
        transparent 3px,
        rgba(0, 0, 0, 0.07) 3px,
        rgba(0, 0, 0, 0.07) 4px
      );
      pointer-events: none;
      z-index: 999;
    }

    .container {
      max-width: 860px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 3rem;
    }

    /* ── HEADER ── */
    header {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }

    .logo {
      font-size: 2.2rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--green);
      text-shadow:
        0 0 8px  rgba(0, 255, 65, 0.8),
        0 0 20px rgba(0, 255, 65, 0.3);
      margin-bottom: 0.5rem;
      line-height: 1;
    }

    .cursor {
      display: inline-block;
      color: var(--green);
    }
    .blink { animation: blink 1s step-end infinite; }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0; }
    }

    .tagline {
      color: var(--cyan);
      font-size: 0.88rem;
      margin-bottom: 0.9rem;
    }

    .header-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.76rem;
      color: var(--text-dim);
    }
    .header-meta strong { color: var(--green); }
    .sep  { color: var(--text-muted); }
    .online { color: var(--green); }

    /* ── SECTION LABEL ── */
    .section-label {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-bottom: 1.2rem;
      white-space: nowrap;
      overflow: hidden;
    }

    /* ── ARTICLE CARDS ── */
    .card {
      border: 1px solid var(--border);
      border-left: 3px solid var(--green-dim);
      padding: 1rem 1.25rem;
      margin-bottom: 0.9rem;
      background: var(--bg-card);
      transition: border-left-color 0.15s ease, background 0.15s ease;
    }
    .card:hover {
      border-left-color: var(--cyan);
      background: #0e1c0e;
    }

    .card-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.4rem;
      font-size: 0.74rem;
      gap: 0.5rem;
    }

    .source {
      color: var(--cyan);
      font-weight: 700;
      white-space: nowrap;
    }
    .date {
      color: var(--text-muted);
      white-space: nowrap;
    }

    .title a {
      display: block;
      color: var(--green);
      text-decoration: none;
      font-size: 0.94rem;
      font-weight: 700;
      line-height: 1.45;
    }
    .title a:hover {
      color: var(--cyan);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .summary {
      color: var(--text-dim);
      font-size: 0.81rem;
      margin-top: 0.45rem;
      line-height: 1.55;
    }

    /* ── FOOTER ── */
    footer {
      border-top: 1px solid var(--border);
      padding-top: 1.5rem;
      margin-top: 2rem;
      color: var(--text-muted);
      font-size: 0.71rem;
      text-align: center;
      line-height: 2;
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 600px) {
      body    { font-size: 13px; }
      .logo   { font-size: 1.6rem; }
      .container { padding: 1.5rem 1rem 2rem; }
      .card-meta { flex-direction: column; align-items: flex-start; gap: 0.15rem; }
    }
  </style>
</head>
<body>
  <div class="container">

    <header>
      <h1 class="logo">CYBERSEC_FEED<span class="cursor blink">█</span></h1>
      <p class="tagline">&gt; Automated Threat Intelligence Digest</p>
      <div class="header-meta">
        <span>UPDATED: <strong>{{ generated_at }}</strong></span>
        <span class="sep">//</span>
        <span>{{ article_count }} ARTICLES LOADED</span>
        <span class="sep">//</span>
        <span class="online">&#x25CF; ONLINE</span>
      </div>
    </header>

    <div class="section-label">// LATEST INTEL ─────────────────────────────────────────────────────────</div>

    <main>
      {% for article in articles %}
      <article class="card">
        <div class="card-meta">
          <span class="source">[ {{ article.source | upper }} ]</span>
          <span class="date">{{ article.date_str }}</span>
        </div>
        <h2 class="title">
          <a href="{{ article.url }}" target="_blank" rel="noopener noreferrer">{{ article.title }}</a>
        </h2>
        {% if article.summary %}
        <p class="summary">&gt;&gt; {{ article.summary }}</p>
        {% endif %}
      </article>
      {% endfor %}
    </main>

    <footer>
      <p>// SOURCES: THE HACKER NEWS &middot; KREBS ON SECURITY &middot; BLEEPINGCOMPUTER &middot; SANS ISC &middot; SCHNEIER &middot; DARK READING</p>
      <p>// AUTO-UPDATED DAILY AT 07:00 AEST &middot; CYBERSEC_FEED v1.0</p>
    </footer>

  </div>
</body>
</html>
